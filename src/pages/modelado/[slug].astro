---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  return [
    { 
      params: { slug: 'residuos-toxicos' }, 
      props: { 
        titulo: 'Modelos Residuos Tóxicos',
        contexto: 'Problemática ambiental sobre el control estricto de componentes peligrosos.',
        detalles: [
          'EMPRESA_PRODUCTORA: Identificada por CIF.',
          'RESIDUO: Identificado por CodigoResiduo y CIF de la empresa productora. Registra el envase definido para el traslado.',
          'CONSTITUYENTE_QUIMICO: Identificado por CodigoConstituyente, con Nombre.',
          'TRASLADO: Identificado por CodigoTraslado, con Fecha y Tratamiento específico.',
          'TRANSPORTADORA: Identificada por CIF.',
          'DESTINO: Identificado por CodigoDestino, con Direccion y FechaLlegada.'
        ],
        relaciones: ['Producir (EMPRESA_PRODUCTORA – RESIDUO | M:N)', 'Componer (RESIDUO – CONSTITUYENTE_QUIMICO | M:N)', 'Incluir (RESIDUO – TRASLADO | 0:N a 1:1 con Cantidad)', 'Realizar (TRANSPORTADORA – TRASLADO | M:N)', 'Dirigir (TRASLADO – DESTINO | N:1)']
      }
    },
    { 
      params: { slug: 'taller-reparacion' }, 
      props: { 
        titulo: 'Modelos Taller de Reparación',
        contexto: 'Sistema de control para el estacionamiento y mantenimiento técnico de vehículos.',
        detalles: [
          'VEHÍCULO: Datos de identificación de entrada, marca, modelo y estado general.',
          'MECÁNICO: Cédula, nombre, especialidad técnica y asignación de turno.',
          'REPUESTOS: Código de pieza, inventario disponible, descripción y costos.',
          'REPARACIÓN: Registro histórico del servicio, horas invertidas y componentes cambiados.'
        ],
        relaciones: ['Asignar Mecánico a Vehículo', 'Registrar Repuestos Utilizados por Reparación', 'Controlar Horas de Servicio Técnico']
      }
    },
    { 
      params: { slug: 'gestion-pedidos' }, 
      props: { 
        titulo: 'Modelos Gestión de Pedidos',
        contexto: 'Estructuración logística para solicitudes, despachos y distribución de productos de consumo.',
        detalles: [
          'CLIENTE: Datos de cuenta, ubicación geográfica de entrega y teléfonos de contacto.',
          'ARTÍCULO: Catálogo general de productos, existencias en almacén y precio base.',
          'REPARTIDOR: Datos del transportador asignado, vehículo de reparto y rutas.',
          'PEDIDO: Código único transaccional, fecha de solicitud y estado de envío.'
        ],
        relaciones: ['Realizar Pedidos por Clientes', 'Contener Artículos por Solicitud', 'Asignar Logística de Entrega']
      }
    },
    { 
      params: { slug: 'lineas-metro' }, 
      props: { 
        titulo: 'Modelos Líneas de Metro',
        contexto: 'Modelado topológico de redes de tránsito ferroviario masivo urbano.',
        detalles: [
          'LÍNEA: Identificador de ruta, color técnico distintivo y longitud total.',
          'ESTACIÓN: Nombre de la parada física, accesos públicos y conexiones.',
          'TREN: Código de máquina de la flota, capacidad máxima y estado técnico.',
          'ACCESO: Torniquetes de control y pasarelas de entrada peatonal.'
        ],
        relaciones: ['Pertenecer Estaciones a Líneas', 'Asignar Flota de Trenes a Rutas', 'Controlar Accesos por Estación']
      }
    },
    { 
      params: { slug: 'biblioteca' }, 
      props: { 
        titulo: 'Modelos Sistema de Biblioteca',
        contexto: 'Administración de préstamos físicos, catálogos de volúmenes y penalizaciones.',
        detalles: [
          'LIBRO: Registro de ISBN, título completo, editorial y año de publicación.',
          'EJEMPLAR: Copias físicas numeradas disponibles para préstamo en sala o domicilio.',
          'USUARIO: Carné de afiliación, nombres completos y estado de cuenta.',
          'AUTOR: Identificador único, nombre completo y nacionalidad.'
        ],
        relaciones: ['Escribir Libros por Autores', 'Generar Ejemplares de Títulos', 'Registrar Préstamos y Multas por Usuario']
      }
    },
    { 
      params: { slug: 'campeonato-futbol' }, // Conserva el slug original del PNG
      props: { 
        titulo: 'Modelos Empresa de Transportes de Paquetes',
        contexto: 'Se desea informatizar la gestión de una empresa de transportes que reparte paquetes por toda Colombia.',
        detalles: [
          'CONDUCTOR: Guarda el número de cédula de ciudadanía, nombre, teléfono, dirección, salario y ciudad en la que vive.',
          'PAQUETE: Interesa conocer el código de paquete, descripción, destinatario y dirección del destinatario.',
          'CIUDAD: Interesa guardar el código de ciudad y el nombre de los destinos a los que llegan las entregas.',
          'CAMIÓN: Matrícula, modelo, tipo y potencia de los vehículos de la flota comercial.'
        ],
        relaciones: [
          'Distribución: Un conductor distribuye muchos paquetes, y un paquete sólo puede ser distribuido por un conductor (N:1).',
          'Destino Ciudad: Un paquete sólo puede llegar a una ciudad; sin embargo, a una ciudad pueden llegar varios paquetes (N:1).',
          'Conducción: Un conductor puede conducir diferentes camiones en fechas diferentes, y un camión puede ser conducido por varios conductores (M:N).'
        ]
      }
    },
    { 
      params: { slug: 'gestion-vuelos' }, // Conserva el slug original del PNG
      props: { 
        titulo: 'Modelos Comidas a Domicilio (Eat\'n Go)',
        contexto: 'Informatización de procesos de venta y distribución logística para una empresa internacional de comidas rápidas.',
        detalles: [
          'ARTICULO: Representa pizzas, bocadillos y productos complementarios (refrescos, helados, etc.). Tiene CodArticulo, Tipo, Tamaño, PrecioBase, PrecioTamaño, IVA y NombreComercial.',
          'INGREDIENTE: Identificado por CodIngrediente, con Nombre, Descripcion, PrecioBocadillo y PrecioPizza.',
          'PEDIDO: Identificado por CodPedido, con FechaHora, TipoPedido (Consumo local, recoger, domicilio), Canal, CargoDom y ValorTotal.',
          'CLIENTE: Identificado por CC, con Nombre, Direccion, Telefono y ConsumoAcumulado.',
          'REPARTIDOR: Identificado por CCR, con Telefono.',
          'SCOOTER: Identificado por Placa, con ConsumoGasolina.',
          'PROMOCION: Identificada por CodPromocion, con TipoBase.',
          'REGALO: Identificado por CodRegalo, con Descripcion y Stock.'
        ],
        relaciones: [
          'CONTENER: ARTICULO – INGREDIENTE | N:M (con Cantidad, PrecioAplicado)',
          'INCLUIR: PEDIDO – ARTICULO | N:1 (con Cantidad, TamañoElegido)',
          'REALIZAR: PEDIDO – CLIENTE | N:1',
          'ASIGNAR: PEDIDO – REPARTIDOR | N:1',
          'USAR: REPARTIDOR – SCOOTER | M:N (con FechaReparto)',
          'APLICAR: CLIENTE – PROMOCION | M:N (con FechaEntrega)',
          'TENER: PROMOCION – REGALO | 1:N'
        ]
      }
    },
    { 
      params: { slug: 'empresa-ingenieria-inversa' }, 
      props: { 
        titulo: 'Modelos Empresa (Ingeniería Inversa)',
        contexto: 'Reconstrucción analítica de un esquema mediante notación formal Peter Chen.',
        detalles: [
          'EMPLOYEE: SSN, Fname, Minit, Lname, Bdate, Address, Sex, Salary y SuperSsn.',
          'DEPARTMENT: Dnumber, Dname, Dlocations y MgrStartDate.',
          'PROJECT: Pnumber, Pname y Plocation.',
          'DEPENDENT: Nombre compuesto, Sex, Bdate y Relationship.'
        ],
        relaciones: ['Supervisar (EMPLOYEE - EMPLOYEE | 1:N)', 'Pertenecer (EMPLOYEE - DEPARTMENT | N:1)', 'Liderar (EMPLOYEE - DEPARTMENT | 1:1)', 'WorksOn (EMPLOYEE - PROJECT | M:N)']
      }
    }
  ];
}

const { slug } = Astro.params;
const { titulo, contexto, detalles, relaciones } = Astro.props;
---

<Layout title={`${titulo} - Detalles`}>
  <section class="detalle-modelo">
    <div class="container">
      <a href={`${base}evidencias/`} class="btn-volver">← Volver a Evidencias</a>

      <header class="modelo-header">
        <h1>{titulo}</h1>
        <p class="contexto-principal">{contexto}</p>
      </header>

      <div class="info-block">
        <h2>Contexto y Componentes Técnicos</h2>
        <div class="estructura-especificaciones">
          <div class="especificacion-col">
            <h3>Entidades y Atributos Principales</h3>
            <ul>
              {detalles.map((detalle) => <li>{detalle}</li>)}
            </ul>
          </div>
          {relaciones && (
            <div class="especificacion-col">
              <h3>Relaciones y Cardinalidades</h3>
              <ul>
                {relaciones.map((relacion) => <li>{relacion}</li>)}
              </ul>
            </div>
          )}
        </div>
      </div>

      <div class="visuales-grid">
        <div class="diagrama-card">
          <div class="card-header">
            <h3>1. Modelo Entidad-Relación (MER / MEER)</h3>
          </div>
          <div class="card-body">
            <div class="image-wrapper">
              <img 
                src={`${base}images/modelos/${slug}-er.png`} 
                alt={`Diagrama Entidad Relación de ${titulo}`}
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <div class="placeholder-fallback">
                <span class="placeholder-icon">📐</span>
                <p>Diagrama conceptual en proceso de renderizado o carga</p>
                <small>Ubicación: public/images/modelos/{slug}-er.png</small>
              </div>
            </div>
          </div>
        </div>

        <div class="diagrama-card">
          <div class="card-header">
            <h3>2. Modelo Relacional (Tablas y Llaves)</h3>
          </div>
          <div class="card-body">
            <div class="image-wrapper">
              <img 
                src={`${base}images/modelos/${slug}-relacional.png`} 
                alt={`Modelo Relacional de ${titulo}`}
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <div class="placeholder-fallback">
                <span class="placeholder-icon">📊</span>
                <p>Esquema lógico relacional en proceso de renderizado o carga</p>
                <small>Ubicación: public/images/modelos/{slug}-relacional.png</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .detalle-modelo {
    padding: 3rem 0;
  }
  .btn-volver {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    margin-bottom: 2rem;
    transition: transform 0.2s;
  }
  .btn-volver:hover {
    transform: translateX(-4px);
  }
  .modelo-header h1 {
    font-size: 2.2rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }
  .contexto-principal {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }
  .info-block {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 2rem;
    border-radius: 12px;
    margin-bottom: 3rem;
  }
  .info-block h2 {
    font-size: 1.35rem;
    margin-top: 0;
    margin-bottom: 1.5rem;
    color: var(--accent);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }
  .estructura-especificaciones {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }
  .especificacion-col h3 {
    font-size: 1.1rem;
    margin-top: 0;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }
  .especificacion-col ul {
    padding-left: 1.25rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .especificacion-col li {
    margin-bottom: 0.5rem;
  }
  .visuales-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
    gap: 2.5rem;
  }
  .diagrama-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .card-header {
    background: var(--bg-secondary);
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .card-header h3 {
    margin: 0;
    font-size: 1.1rem;
    color: var(--text-primary);
  }
  .card-body {
    padding: 1.5rem;
  }
  .image-wrapper {
    position: relative;
    width: 100%;
    min-height: 380px;
    background: var(--bg-secondary);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px dashed var(--border);
  }
  .image-wrapper img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  .placeholder-fallback {
    display: none; /* Corrección del Bug Visual: oculto por defecto */
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    color: var(--text-secondary);
    position: absolute;
  }
  .placeholder-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    opacity: 0.6;
  }
  .placeholder-fallback p {
    font-size: 0.95rem;
    margin: 0 0 0.5rem 0;
  }
  .placeholder-fallback small {
    font-family: monospace;
    font-size: 0.78rem;
    opacity: 0.5;
  }
</style>