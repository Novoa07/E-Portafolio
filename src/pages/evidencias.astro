---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

const ejerciciosModelado = [
  { slug: 'residuos-toxicos', titulo: 'Modelos Residuos Tóxicos' },
  { slug: 'taller-reparacion', titulo: 'Modelos Taller de Reparación' },
  { slug: 'gestion-pedidos', titulo: 'Modelos Gestión de Pedidos' },
  { slug: 'lineas-metro', titulo: 'Modelos Líneas de Metro' },
  { slug: 'biblioteca', titulo: 'Modelos Sistema de Biblioteca' },
  { slug: 'campeonato-futbol', titulo: 'Modelos Empresa de Transportes' },
  { slug: 'gestion-vuelos', titulo: 'Modelos Comidas a Domicilio (Eat\'n Go)' },
  { slug: 'empresa-ingenieria-inversa', titulo: 'Modelos Empresa (Ingeniería Inversa)' }
];
---

<Layout title="Evidencias - Mi Portafolio">
  <section class="evidencias">
    <div class="container">
      <h1 class="page-title">Evidencias del Curso</h1>
      <p class="page-subtitle">Bases de Datos 1 - Universidad El Bosque</p>

      <div class="evidencias-grid">
        <div class="categoria-card">
          <div class="categoria-header">
            <div class="icon">🗂️</div>
            <h2>Modelado de Datos</h2>
          </div>
          <div class="categoria-content">
            <p class="descripcion">
              Diseño conceptual y lógico de diagramas entidad-relación avanzados y relacionales.
            </p>
            <nav class="ejercicios-links">
              {ejerciciosModelado.map((ejercicio) => (
                <a href={`${base}modelado/${ejercicio.slug}/`} class="ejercicio-link">
                  <span class="link-bullet">➔</span> {ejercicio.titulo}
                </a>
              ))}
            </nav>
          </div>
        </div>

        <div class="categoria-card">
          <div class="categoria-header">
            <div class="icon">⚙️</div>
            <h2>Normalización</h2>
          </div>
          <div class="categoria-content">
            <p class="descripcion">
              Transformación formal de esquemas lógicos para eliminar redundancias y anomalías operacionales.
            </p>
            <div class="evidencias-list">
              <div class="evidencia-item">
                <h3>Casos Prácticos de 1FN, 2FN y 3FN</h3>
                <p>Análisis y descomposición de tablas mediante dependencias funcionales para garantizar la integridad referencial.</p>
                <span class="status-badge">Documentado</span>
              </div>
            </div>
          </div>
        </div>

        <div class="categoria-card">
          <div class="categoria-header">
            <div class="icon">💻</div>
            <h2>Consultas SQL</h2>
          </div>
          <div class="categoria-content">
            <p class="descripcion">
              Estructuras DDL y consultas transaccionales implementadas en sistemas gestores relacionales.
            </p>
            <div class="evidencias-list">
              <div class="evidencia-item">
                <h3>Scripts y Operaciones Relacionales</h3>
                <p>Construcción de bases de datos, inserciones masivas de prueba y desarrollo de consultas complejas con uniones avanzadas.</p>
                <span class="status-badge">Implementado</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .evidencias {
    padding: 4rem 0;
  }
  .page-title {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    text-align: center;
  }
  .page-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    text-align: center;
    margin-bottom: 3rem;
  }
  .evidencias-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 2rem;
  }
  .categoria-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  .categoria-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
  }
  .categoria-header h2 {
    font-size: 1.45rem;
    margin: 0;
    color: var(--text-primary);
  }
  .icon {
    font-size: 1.8rem;
  }
  .descripcion {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .ejercicios-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .ejercicio-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.95rem;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    transition: all 0.2s ease-in-out;
    border-left: 3px solid transparent;
  }
  .ejercicio-link:hover {
    color: var(--accent);
    background: rgba(59, 130, 246, 0.05);
    border-left-color: var(--accent);
    transform: translateX(4px);
  }
  .link-bullet {
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .ejercicio-link:hover .link-bullet {
    opacity: 1;
  }
  .evidencias-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .evidencia-item {
    background: var(--bg-secondary);
    padding: 1.25rem;
    border-radius: 10px;
    border: 1px solid var(--border);
  }
  .evidencia-item h3 {
    font-size: 1.1rem;
    margin: 0 0 0.5rem 0;
  }
  .evidencia-item p {
    color: var(--text-secondary);
    font-size: 0.88rem;
    margin: 0 0 1rem 0;
    line-height: 1.5;
  }
  .status-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    background: rgba(59, 130, 246, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    border: 1px solid rgba(59, 130, 246, 0.2);
  }
</style>